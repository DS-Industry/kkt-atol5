# Example systemd unit for Orange Pi (F-OPS-05).
#
# Install (as root, after adjusting paths/user):
#   sudo cp deploy/kkt-atol5.service /etc/systemd/system/kkt-atol5.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kkt-atol5
#
# Notes:
# - Single process only — do not use multi-worker Gunicorn; APScheduler job1 and
#   the USB KKT must not race across workers (see docs/ops-runbook.md §1).
# - HTTP host/port come from instance/config.json (defaults http_host/http_port
#   in conf.py, typically 0.0.0.0:5000). Changing bind requires a service restart.
# - libfptr10 / ATOL driver must be installed on the host (LIBRARY_PATH, often /usr/lib/).
# - Set User= to a non-root account that can access the USB device and write instance/.

[Unit]
Description=kkt-atol5 ATOL fiscal Flask service
After=network.target
# Optional: wait for USB subsystem if the KKT is always on this host
# After=network.target systemd-udev-settle.service

[Service]
Type=simple
# User=kkt
# Group=kkt
WorkingDirectory=/opt/kkt-atol5
# Prefer a venv if you install deps there:
# ExecStart=/opt/kkt-atol5/.venv/bin/python3 main.py
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=5
# Optional env overlays (scheduler off for debug only):
# Environment=DISABLE_SCHEDULER=1
# Environment=PYTHONUNBUFFERED=1

# Soft hardening (uncomment if paths/permissions allow)
# NoNewPrivileges=true
# PrivateTmp=true

[Install]
WantedBy=multi-user.target
